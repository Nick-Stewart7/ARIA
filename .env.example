# Tavily API key — used by the Researcher sub-agent for web search
# Get one at https://tavily.com
TAVILY_API_KEY=tvly-...

# Strands framework setting — skips tool confirmation prompts at runtime
BYPASS_TOOL_CONSENT=True

# Session identity — sets who you are and which conversation to load
USER_ID=user
DEFAULT_CONVERSATION_ID=main

# AWS credentials are required for the default Bedrock model provider.
# Configure these via the AWS CLI (`aws configure`) or set them here:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
